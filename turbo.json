{
  "$schema": "https://turbo.build",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "**/dist/**", "**/.vitepress/dist/**"]
    },
    "desktop:build": {
      "dependsOn": ["build"],
      "outputs": ["dist-electron/**", "release/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
