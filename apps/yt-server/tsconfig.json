{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,         /* 🟩 CRITICAL: Fixes the default import mapping */
    "skipLibCheck": true,            /* Avoids compilation errors inside node_modules */
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}
